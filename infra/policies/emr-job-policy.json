{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectLabBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:ListBucketMultipartUploads"],
      "Resource": "arn:aws:s3:::twitter-combined-a0281523j"
    },
    {
      "Sid": "ReadDatasetAndScript",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::twitter-combined-a0281523j/input/*",
        "arn:aws:s3:::twitter-combined-a0281523j/scripts/*"
      ]
    },
    {
      "Sid": "WriteResultsAndLogs",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": [
        "arn:aws:s3:::twitter-combined-a0281523j/output/*",
        "arn:aws:s3:::twitter-combined-a0281523j/logs/*"
      ]
    }
  ]
}
